#--------fire_ops配置-------
DEBUG=true
GUNICORN_WORKERS=1

#--------elasticsearch配置-------
discovery.type=single-node
ES_HOST=elasticsearch
ES_PORT=9200

#--------kafka配置-------
KAFKA_HOST=kafka
KAFKA_PORT=9092

#--------redis配置-------
REDIS_HOST=redis
REDIS_PORT=6379

#--------postgresql配置-------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=OTcxMDEx
POSTGRES_DB=fire_ops

#--------kibana配置-------
ELASTICSEARCH_HOSTS=["http://elasticsearch:9200"]
I18N_LOCALE=zh-CN

#--------DeepSeek（OpenAI 兼容）-------
OPENAI_API_KEY=sk-4608ac4ebd8a4c1c89a035830bfc0d4d
OPENAI_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat

#--------向量数据库类型选择-------
# 可选: chroma, qdrant
VECTOR_DB_TYPE=qdrant

#--------ChromaDB配置-------
CHROMA_COLLECTION=documents

#--------Qdrant配置-------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=documents

#--------Document Process（DP）-------
# 文档解析主路径：true 走 DP，false 回退本地 EasyOCR
DP_ENABLED=true
DP_BASE_URL=http://host.docker.internal:8890
DP_API_KEY=
DP_DEFAULT_BACKEND=pipeline
DP_POLL_SECONDS=2
DP_TIMEOUT_SECONDS=7200

#--------OCR配置（DP_ENABLED=false 时本地回退）-------
OCR_ENABLED=false
OCR_USE_GPU=true
OCR_MAX_CONCURRENT_PAGES=1
OCR_BATCH_SIZE=5
OCR_DPI=150

#--------搜索配置-------
SIMILARITY_THRESHOLD=0.7

HF_OFFLINE=true
HF_HOME=/app/models
RERANK_ENABLED=false
